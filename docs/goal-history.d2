direction: down

source {
  "Session branch" -> "All workpad snapshots in toolResult.details"
  bg: "#f0f4ff"
}

reconstruct {
  "Forward-walk the branch" -> "Normalize legacy goal → currentFocus" -> "Dedupe consecutive identical snapshots" -> "Overall-goal + focus timeline (bounded, last ~10)"
  bg: "#eaf7ea"
}

audiences {
  "mini-self-org-history tool" {
    label: "LLM-facing, explicitly requested"
    bg: "#fff7e0"
  }
  "/mini-self-org-history command" {
    label: "TUI, read-only, on demand"
    bg: "#fff7e0"
  }
}

source -> reconstruct -> audiences
"Current: one snapshot carries overallGoal + currentFocus; only current state is injected" {
  style.fill: "#f5f5f5"
}
